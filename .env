# Base map tiles published by .github/workflows/basemap.yml.
# Leave empty to run without a base map. If the files are unreachable the map loads without it.
VITE_BASEMAP_URL=https://engdawood.github.io/yemen-map

# Turnstile site key for the "draw your line" form (public; the secret is a Worker secret).
# Its widget allows yemen-map.dawod.workers.dev; add any custom domain to it in the Cloudflare dashboard.
# `npm run dev` uses Cloudflare's test key from .env.development instead.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFAxzwwf6HdRvPFM
